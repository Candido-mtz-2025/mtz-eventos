# Modelo sem segredos. Nao carregar automaticamente no modo local.
APP_ENV=homologation
PUBLIC_ORIGIN=https://homolog.example.invalid
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CONFIGURAR_NO_SERVIDOR
DATABASE_URL=postgresql://orc_app:CONFIGURAR_NO_SERVIDOR@DB_HOST:5432/postgres
# Opcional quando a CA nao esta no trust store do sistema:
PG_CA_FILE=
PORT=3000
# TLS direto OU terminacao por proxy explicitamente confiavel. Nunca confiar em X-Forwarded-Proto de qualquer IP.
TLS_CERT_FILE=
TLS_KEY_FILE=
TRUSTED_PROXY_CIDRS=
# Administracao separada; nunca disponibilizar estes valores ao processo da API:
ADMIN_DATABASE_URL=
ADMIN_EXPECTED_HOST=
CONFIRM_SYNTHETIC_ADMIN=no
ORC_APP_PASSWORD=
BACKUP_KEY_BASE64=
RESTORE_DATABASE_URL=
